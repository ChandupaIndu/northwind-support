# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database (used by docker-compose.yml) ---------------------------------
# Local-only fixture for the SQL Server container. Choose a private value for local use.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- Backend ---------------------------------------------------------------
# Local development only; replace with a private random key in your environment.
Jwt__SigningKey=Northwind-Support-Local-Only-JWT-Key-Change-Before-Deployment-2026
# For a host-run API, use localhost. Compose sets the container's connection string
# at runtime with Server=sqlserver so the API connects over the Compose network.
# ASP.NET Core uses "__" for nested configuration sections.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False

# Development turns on Swagger, the automatic migration and the demo seed data.
ASPNETCORE_ENVIRONMENT=Development
